{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ModernSummaryApp",
  "version": "1.0.0",
  "identifier": "com.modernsummary.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Modern Summary App - Ultra Fast Accounting",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
